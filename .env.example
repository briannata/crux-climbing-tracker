# Copy to .env and fill in. Anything starting with EXPO_PUBLIC_ is bundled
# into the client at build time (and visible to anyone who unpacks the app).
# That's fine for these values — the anon key is meant to be public; we rely
# on server-side RLS for protection.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
